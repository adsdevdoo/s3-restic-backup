# Host directory for the bucket copies, the restic repository and the state. Must exist.
DATA_DIR=/srv/s3-backup

# Sources: names of your choice, space-separated; lower-case letters, digits and _, starting with a letter.
# Each source <name> has the settings <NAME>_* below and the keys secrets/<name>_access_key and
# secrets/<name>_secret_key.
SOURCES=prod dev

# Per source:
#   <NAME>_BUCKET        bucket name (required)
#   <NAME>_PREFIX        only this path in the bucket; empty = the whole bucket
#   <NAME>_ENDPOINT      S3 endpoint URL; empty for AWS
#   <NAME>_REGION        region; empty = provider default
#   <NAME>_PROVIDER      rclone S3 provider (AWS, Ceph, Minio, Wasabi, Other, ...); default Other
#   <NAME>_PATH_STYLE    yes: path-style URLs (https://endpoint/bucket), no: virtual-host style; default yes
#   <NAME>_SCHEDULE      cron schedule; default SCHEDULE
#   <NAME>_KEEP_HOURLY, _KEEP_DAILY, _KEEP_WEEKLY, _KEEP_MONTHLY   retention; default the global KEEP_*
#   <NAME>_RCLONE_FLAGS  extra rclone flags; default RCLONE_FLAGS
PROD_BUCKET=my-bucket
PROD_ENDPOINT=https://s3.example.com
PROD_REGION=
DEV_BUCKET=my-bucket-dev
DEV_ENDPOINT=https://s3.example.com
DEV_REGION=
DEV_SCHEDULE=0 5 * * *

# Default cron schedule and the time zone of all schedules.
SCHEDULE=30 4 * * *
TZ=UTC

# Default snapshot retention. With a schedule more often than daily, KEEP_HOURLY keeps that many hourly snapshots.
KEEP_HOURLY=0
KEEP_DAILY=30
KEEP_WEEKLY=8
KEEP_MONTHLY=24
# restic check on this weekday (1 = Monday, 7 = Sunday; empty = never), reading this share of the data.
CHECK_WEEKDAY=7
CHECK_READ_SUBSET=10%

# Extra rclone flags for every source, e.g. --bwlimit 10M --tpslimit 10. Space-separated, no quoting. They apply
# to the listing too; --dump, --log-file and --s3-sdk-log-mode are refused (they would print the keys). RCLONE_*
# variables here don't reach rclone.
RCLONE_FLAGS=

# Host name of the snapshots; retention only touches snapshots with this one, so don't change it later.
SNAPSHOT_HOST=s3-backup

# Optional off-host copy of the restic repository, rsync over SSH. Empty = off. user@host:path, colon required.
# Key: secrets/copy_ssh_key, host key: secrets/copy_known_hosts.
COPY_TARGET=
# COPY_TARGET=bkcopy@backup-host.example:
COPY_PORT=22
# COPY_KEY_FILE=/run/secrets/copy_ssh_key
# COPY_KNOWN_HOSTS_FILE=/run/secrets/copy_known_hosts
