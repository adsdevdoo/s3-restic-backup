   "id": 4,
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(((max by (source) (s3_backup_last_failure_timestamp_seconds{source=~\"$source\"}) > bool max by (source) (s3_backup_last_success_timestamp_seconds{source=~\"$source\"})) or (max by (source) (s3_backup_last_failure_timestamp_seconds{source=~\"$source\"}) * 0 + 1) or (max by (source) (s3_backup_last_success_timestamp_seconds{source=~\"$source\"}) * 0))) or vector(0)",
     "legendFormat": "",
     "refId": "F"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
