{
 "uid": "s3-backup",
 "title": "S3 backup",
 "tags": [
  "backup",
  "s3"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {}
   },
   {
    "name": "source",
    "label": "Source",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values({__name__=~\"s3_backup_last_(success|failure)_timestamp_seconds\"}, source)",
     "refId": "source"
    },
    "definition": "label_values({__name__=~\"s3_backup_last_(success|failure)_timestamp_seconds\"}, source)",
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Sources",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Sources",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(max by (source) (s3_backup_last_success_timestamp_seconds{source=~\"$source\"}) or max by (source) (s3_backup_last_failure_timestamp_seconds{source=~\"$source\"}))",
     "legendFormat": "",
     "refId": "D"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": []
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Sources whose last run failed",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
